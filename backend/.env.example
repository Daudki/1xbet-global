PORT=4000
NODE_ENV=development
# Your site(s), comma separated. Needed for the admin to talk to the API.
FRONTEND_ORIGIN=http://localhost:5173,https://sportsbet-tips.com

# Neon (or any Postgres)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=replace-with-a-random-string-of-32-or-more-characters

# Cloudinary (images). Leave empty to turn uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sportsbet/articles

# Vercel Deploy Hook URL: publishing an article rebuilds the site
DEPLOY_HOOK_URL=

# Creates the first admin once, when there are no users yet
ADMIN_EMAIL=
ADMIN_NAME=Admin
ADMIN_PASSWORD=
